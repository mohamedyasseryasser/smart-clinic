@model IEnumerable<smart_clinic.viewmodels.userviewmodel.responsereceptionistviewmodel>

@{
    ViewData["Title"] = "Receptionists";
    var pageNumber = ViewBag.PageNumber is int currentPage ? currentPage : 1;
    var pageSize = ViewBag.PageSize is int currentPageSize ? currentPageSize : 10;
}

<div class="container-fluid py-4">
    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @successMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @errorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <div>
                <h4 class="mb-1 text-primary fw-bold">Receptionists</h4>
                <span class="text-muted small">View and manage clinic reception staff</span>
            </div>
            <a asp-action="AddReceptionist" class="btn btn-primary">
                <i class="fas fa-user-plus me-1"></i> Add Receptionist
            </a>
        </div>

        <div class="card-body">
            <form asp-action="ListReceptionists" method="get" class="row g-2 mb-4">
                <div class="col-md-6 col-lg-4">
                    <label for="searchTerm" class="form-label small fw-bold text-muted">Search</label>
                    <input id="searchTerm" type="search" name="searchTerm" value="@ViewBag.SearchTerm"
                           class="form-control" placeholder="Username, email, phone, or address" />
                </div>
                <div class="col-auto d-flex align-items-end">
                    <button type="submit" class="btn btn-secondary">
                        <i class="fas fa-search me-1"></i> Search
                    </button>
                </div>
                <div class="col-auto d-flex align-items-end">
                    <a asp-action="ListReceptionists" class="btn btn-outline-secondary">Clear</a>
                </div>
            </form>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Username</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Salary</th>
                            <th>Hire Date</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="fw-semibold">@item.UserName</td>
                                    <td>@item.Email</td>
                                    <td>@item.PhoneNumber</td>
                                    <td>@item.salary.ToString("C")</td>
                                    <td>@item.hiredate.ToShortDateString()</td>
                                    <td>
                                        @if (item.IsActive)
                                        {
                                            <span class="badge rounded-pill bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill bg-secondary">Inactive</span>
                                        }
                                    </td>
                                    <td class="text-end text-nowrap">
                                        <a asp-action="ReceptionistDetails" asp-route-id="@item.resptionistid"
                                           class="btn btn-sm btn-outline-info" title="Details">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-action="UpdateReceptionist" asp-route-id="@item.resptionistid"
                                           class="btn btn-sm btn-outline-primary" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        @if (item.IsActive)
                                        {
                                            <form asp-action="RemoveReceptionist" asp-route-id="@item.Id" method="post"
                                                  class="d-inline" onsubmit="return confirm('Deactivate this receptionist?');">
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Deactivate">
                                                    <i class="fas fa-user-slash"></i>
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-5">
                                    <i class="fas fa-users fa-2x mb-2 d-block"></i>
                                    No receptionists found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card-footer bg-white d-flex justify-content-between align-items-center">
            <span class="text-muted small">Page @pageNumber</span>
            <div class="d-flex gap-2">
                @if (pageNumber > 1)
                {
                    <a asp-action="ListReceptionists" asp-route-pageNumber="@(pageNumber - 1)"
                       asp-route-pageSize="@pageSize" asp-route-searchTerm="@ViewBag.SearchTerm"
                       class="btn btn-sm btn-outline-secondary">Previous</a>
                }
                @if (Model != null && Model.Count() == pageSize)
                {
                    <a asp-action="ListReceptionists" asp-route-pageNumber="@(pageNumber + 1)"
                       asp-route-pageSize="@pageSize" asp-route-searchTerm="@ViewBag.SearchTerm"
                       class="btn btn-sm btn-outline-primary">Next</a>
                }
            </div>
        </div>
    </div>
</div>
